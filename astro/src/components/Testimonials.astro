---
import { testimonials } from "../data/content";
---

{testimonials.length > 0 && (
  <section id="testimonials" class="mx-auto max-w-[1100px] px-6 py-16">
    <h2 class="mb-4 text-xl font-medium">Testimonials</h2>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {testimonials.map((t) => (
        <blockquote class="rounded-xl bg-neutral-50 p-5">
          <p class="mb-3 italic">&ldquo;{t.quote}&rdquo;</p>
          <footer class="text-sm text-neutral-500">{t.name}, {t.role}</footer>
        </blockquote>
      ))}
    </div>
  </section>
)}
