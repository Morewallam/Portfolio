---
import { site, socials } from "../data/content";

const year = new Date().getFullYear();
---

<footer class="mx-auto flex max-w-[1100px] justify-between border-t border-neutral-200 px-6 py-6 text-sm text-neutral-500">
  <span>&copy; {year} {site.name}</span>
  <div class="flex gap-4">
    {socials.map((s) => (
      <a href={s.url} target="_blank" rel="noopener" aria-label={s.label} class="hover:text-neutral-900">
        {s.label}
      </a>
    ))}
  </div>
</footer>
