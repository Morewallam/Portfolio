---
import { experience } from "../data/content";
---

<section id="experience" class="mx-auto max-w-[1100px] px-6 py-16">
  <h2 class="mb-4 text-xl font-medium">Experience</h2>
  <ol class="flex flex-col gap-6">
    {experience.map((item) => (
      <li class="border-l-2 border-neutral-200 pl-4">
        <div class="mb-1 flex flex-wrap gap-2 text-sm">
          <strong>{item.role}</strong>
          <span>{item.org}</span>
          <span class="ml-auto text-neutral-400">{item.dates}</span>
        </div>
        <p class="m-0 text-sm text-neutral-500">{item.summary}</p>
      </li>
    ))}
  </ol>
</section>
